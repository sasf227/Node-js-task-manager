<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Tickets</title>

    <link rel="stylesheet" href="css/reset.css">
    <link rel="stylesheet" href="css/layout.css">
    <link rel="stylesheet" href="css/tickets.css">
</head>
<body>

<div class="app">

    <!-- Sidebar -->
    <%- include('./templates/global/sidebar') %>

    <!-- Main -->
    <main class="tickets-main">

        <!-- Header -->
        <div class="tickets-header">

            <div>
                <h1>Your Tickets</h1>
                <p>Your issues and requests reports</p>
            </div>

            <button onclick="window.location.href='/ticket'">Create Ticket</button>

        </div>


        <!-- Search -->
        <div class="tickets-search">

            <input type="text" placeholder="Search tickets...">

            <select>
                <option>All</option>
                <option>Open</option>
                <option>In Progress</option>
                <option>Closed</option>
            </select>

        </div>

        <!-- Tickets -->
        <div class="tickets-list">

            <!-- Ticket -->
            <% tickets.map((ticket) => { %>
                <% const status = ['Open', 'Snoozed', 'Resolved', 'Closed'] %>
                <% const priority = ['Low', 'Medium', 'High'] %>
                <div class="ticket-card 
                <% if (ticket.status_id === 4) { %>
                    Closed
                <% } else if (ticket.status_id === 3) { %>
                    Resolved
                <% } else if (ticket.status_id === 2) { %>
                    Snoozed
                <% } else { %>
                    <%= priority[ticket.priority_id - 1] %>
                <% } %>">

                <div class="ticket-top">

                    <div>
                        <h3><%= ticket.subject %></h3>
                        <span>#<%= ticket.reference_number %></span>
                    </div>

                    <div class="ticket-status <% if (ticket.priority_id === null) {%>
                            In progress
                        <% } else {%>
                            <%= status[ticket.status_id - 1] %>
                        <% } %>">

                        <% if (ticket.priority_id === null) {%>
                            In progress
                        <% } else { %>
                            <%= status[ticket.status_id - 1] %>
                        <% } %>
                        
                    </div>

                </div>

                <p class="ticket-message">
                    <%= ticket.custom_attributes.description %>
                </p>

                <div class="ticket-footer">

                   

                    <div class="ticket-priority">
                        <% if (ticket.priority_id === null) {%>
                            In progress
                        <% } else { %>
                            Priority: <%= priority[ticket.priority_id - 1] %> 
                        <% } %>
                        
                    </div>

                </div>

            </div>
            <% }) %>
            

            <!-- Ticket -->
            <!-- <div class="ticket-card medium">

                <div class="ticket-top">

                    <div>
                        <h3>Task sync bug</h3>
                        <span>#1043</span>
                    </div>

                    <div class="ticket-status progress">
                        In Progress
                    </div>

                </div>

                <p class="ticket-message">
                    Tasks are not syncing correctly between devices.
                </p>

                <div class="ticket-footer">

                    <div class="ticket-user">
                        <img src="https://i.pravatar.cc/40?img=7">
                        <div>
                            <p>Anna Smith</p>
                            <span>anna@example.com</span>
                        </div>
                    </div>
                </div>

            </div> -->

        </div>

    </main>

</div>

</body>
</html>