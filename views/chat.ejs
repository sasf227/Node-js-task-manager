<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Chat - TaskFlow</title>

    <link rel="stylesheet" href="css/reset.css">
    <link rel="stylesheet" href="css/layout.css">
    <link rel="stylesheet" href="css/dashboard.css">
    <link rel="stylesheet" href="css/chat.css">
</head>
<body>
    <div class="app">
        <!-- Sidebar (same as dashboard) -->
        <aside class="sidebar">
            <h2 class="logo">TaskFlow</h2>

            <nav>
                <a href="/home" class="active">Home</a>
                <a href="/chat">Chat</a>
                <a href="http://10.0.0.144:8082/dashboard.php">Calendar</a>
                <a href="/friends">Friends</a>
                <a>Notifications</a>
                <a>Settings</a>
                <a href="/howTo">How to</a>
            </nav>
        </aside>

        <!-- Chat Layout -->
        <main class="chat-main">
            <!-- Chat List -->
            <div class="chat-list">
                <h3>Chats</h3>
                <input type="text" placeholder="email" id="newChat">
                <button class="chat-user" onclick="newChat()">
                    <h1>New Chat</h1>
                </button>
            </div>
                
            <!-- Chat Window -->
            <div class="chat-window">
                <!-- Header -->
                <div class="chat-header">
                    <img src="https://i.pravatar.cc/40?img=1">
                    <h3>John Doe</h3>
                </div>

                <!-- Messages -->
                <div class="chat-messages">
                    <!-- <div class="message other">
                    <p>Hey, did you finish the task?</p>
                    <span>10:30</span>
                    </div>

                    <div class="message me">
                        <p>Almost done, just testing it</p>
                        <span>10:32</span>
                    </div>

                    <div class="message other">
                    <p>Nice 👍</p>
                    <span>10:33</span>
                    </div> -->
                </div>
                
                <!-- Input -->
                <form class="chat-input">
                    <input type="text" class="input" autocomplete="off" autofocus placeholder="Type a message...">
                    <button>Send</button>
                </form>
            </div>
        </main>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const jwt = `<%= token %>`
        const form = document.querySelector(".chat-input");
        const input = document.querySelector(".input");
        const messages = document.querySelector(".chat-messages");
        const newChatInput = document.getElementById('newChat');
        const chatlist = document.querySelector(".chat-list")
        
        const socket = io()

        socket.emit("handshake", jwt)

        async function newChat() {
            const email = newChatInput.value;

            const res = await fetch ("/chat/chat", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify({
                    emailto: email,
                })
            });
            const data = await res.json();
            if(data.chat === "created") {
                socket.emit("new chat", email);
                const div = document.createElement("div");
                div.className = "chat-user active";

                div.innerHTML = `
                    <img src="https://i.pravatar.cc/40?img=1">
                    <div>
                        <p class='user-email active' value=${email}>${data.username}</p>
                        <!-- <span>Hey, did you finish?</span> -->
                    </div>
                `;

                chatlist.appendChild(div);

                // scroll outside chat
                chatlist.scrollTop = chatlist.scrollHeight;
                newChatInput.value = "";
            }
            
        }
        

        form.addEventListener("submit", function(event) {
            event.preventDefault();
            const userEmail = document.querySelector(".user-email.active").value
            
            if (input.value && userEmail.value) {
                socket.emit("chat message", userEmail.value, input.value);
            }

            input.value = "";
        });


        socket.on("chat message", function(data) {
            const currentUser = "<%= user.email %>";

            const type = data.email === currentUser ? "me" : "other";

            addMessage(data.sender, data.message, type);
        });

        function addMessage(username, message, type) {
            const div = document.createElement("div");
            div.className = "message " + type;

            div.innerHTML = `
                <p>${username}: ${message}</p>
                <span>${new Date().getHours()}:${new Date().getMinutes()}</span>
            `;

            messages.appendChild(div);

            // scroll inside chat
            messages.scrollTop = messages.scrollHeight;
        }
    </script>
    
</body>
</html>