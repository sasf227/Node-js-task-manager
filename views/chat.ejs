<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Chat - TaskFlow</title>

    <link rel="stylesheet" href="css/reset.css">
    <link rel="stylesheet" href="css/layout.css">
    <link rel="stylesheet" href="css/dashboard.css">
    <link rel="stylesheet" href="css/chat.css">
</head>
<body>
    <div class="app">
        <!-- Sidebar (same as dashboard) -->
        <%- include('./templates/global/sidebar') %>
        <!-- Chat Layout -->
        
        <main class="chat-main">
            <!-- Chat List -->
            <div class="chat-list">
                <h3>Chats</h3>
                <input type="text" placeholder="email" id="newChat">
                <button class="newchat" onclick="newChat()">
                    <h1>New Chat</h1>
                </button>
                <% chats.map((chat) => { %>
                    <div class="chat-user">
                        <img src='<%= chat.imgpath %>' width="49px" height="49px">
                        <div>
                            <p><%= chat.username %></p>
                            <span><%= chat.chat_with %></span>
                            <!-- <span>Hey, did you finish?</span> -->
                        </div>
                    </div>
                <% }) %>
            </div>
                
            <!-- Chat Window -->
            <div class="chat-window">
                <!-- Header -->
                <div class="chat-header">
                    <img src="https://i.pravatar.cc/40?img=1">
                    <h3>John Doe</h3>
                </div>

                <!-- Messages -->
                <div class="chat-messages"></div>
                
                <!-- Input -->
                <div class="chat-input">
                    <input type="text" class="input" id="submit-input" autocomplete="off" autofocus placeholder="Type a message...">
                    <button id="submit-message">Send</button>
                </div>
            </div>
        </main>
    </div>
    <button onclick="openSupport()">Report issue</button>

    <div id="modal" style="display:none;">
        <input type="email", placeholder="Your Email" id="report_email">
        <input id="subject" placeholder="Subject" />
        <textarea id="message" placeholder="Describe the problem"></textarea>
        <button onclick="sendTicket()">Send</button>
    </div>
    <script>
        function openSupport() {
            document.getElementById("modal").style.display = "block";
        }

            async function sendTicket() {
                await fetch("http://10.0.0.85:3000/api/tickets", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        subject: document.getElementById("subject").value,
                        message: document.getElementById("message").value,
                        email: document.getElementById("report_email").value
                    })
                });
                alert("Ticket sent!");
            }
    </script>
    <script src="/socket.io/socket.io.js"></script>
    <script>
        const jwt = `<%= token %>`
        const form = document.querySelector(".chat-input");
        const input = document.querySelector(".input");
        const messages = document.querySelector(".chat-messages");
        const newChatInput = document.getElementById('newChat');
        const chatlist = document.querySelector(".chat-list")
        
        const socket = io()

        socket.emit("handshake", jwt)

        
        const chatUsers = document.querySelectorAll(".chat-user");
        chatUsers.forEach(user => {

            user.addEventListener("click", () => {
                const userEmail = user.lastElementChild.lastElementChild.innerHTML
                socket.emit("new chat", userEmail)
                
                // remove active from all
                chatUsers.forEach(u => {
                    u.classList.remove("active");
                });

                // add active to clicked one
                user.classList.add("active");

            });
        });


        async function newChat() {
            const removeActive = document.querySelector(".chat-user.active")
            if (removeActive) removeActive.classList.remove("active") 
            const email = newChatInput.value;

            const res = await fetch ("/chat/chat", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify({
                    emailto: email,
                })
            });
            const data = await res.json();
            if(data.chat === "created" || data.chat === "connected") {
                socket.emit("new chat", email);
                const div = document.createElement("div");
                div.className = "chat-user active";

                div.innerHTML = `
                    <img src=${data.imgpath} width="49px" height="49px">
                    <div>
                        <p>${data.username}</p>
                        <span>${email}</span>
                        <!-- <span>Hey, did you finish?</span> -->
                    </div>
                `;

                chatlist.appendChild(div);

                // scroll outside chat
                chatlist.scrollTop = chatlist.scrollHeight;
                newChatInput.value = "";
            }
            
        }
        
        
        function submit () {
            event.preventDefault();
            const removeActive = document.querySelector(".chat-user.active")
            if (!input.value) return 
            if (!removeActive) return
            const userEmail = document.querySelector(".chat-user.active").lastElementChild.lastElementChild.innerHTML
            
            if (input.value && userEmail) {
                socket.emit("chat message", userEmail, input.value);
            }

            input.value = "";
        };

        const submitMessage = document.getElementById('submit-message');
        const submitInput = document.getElementById('submit-input');
        submitInput.addEventListener("keydown", (event) => {
            if (event.key === "Enter") {
                event.preventDefault();
                submit();
            }
        });

        // BUTTON click
        submitMessage.addEventListener("click", (event) => {
            event.preventDefault();
            submit();
        });


        socket.on("chat message", function(data) {
            const currentUser = "<%= user.email %>";

            const type = data.email === currentUser ? "me" : "other";


            addMessage(data.sender, data.message, type);
        });

        function addMessage(username, message, type) {
            const div = document.createElement("div");
            div.className = "message " + type;

            div.innerHTML = `
                <p>${username}: ${message}</p>
                <span>${new Date().getHours()}:${new Date().getMinutes()}</span>
            `;

            messages.appendChild(div);

            // scroll inside chat
            messages.scrollTop = messages.scrollHeight;
        }
    </script>
    
</body>
</html>